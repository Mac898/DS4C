{
  "schemaVersion": 1,
  "id": "${mod_id}",
  "version": "${version}",
  "name": "${mod_name}",
  "description": "${description}",
  "authors": [
    "${mod_author}"
  ],
  "contact": {
    "homepage": "https://github.com/Mac898/DS4C",
    "sources": "https://github.com/Mac898/DS4C",
    "issues": "https://github.com/Mac898/DS4C/issues"
  },
  "icon": "assets/${mod_id}/icon.png",
  "license": "${license}",
  "environment": "client",
  "entrypoints": {
    "client": [
      "au.mltech.ds4c.Ds4c"
    ],
    "modmenu": [
      "au.mltech.ds4c.Ds4cModMenu"
    ]
  },
  "mixins": [
    "${mod_id}.mixins.json",
    "${mod_id}.controlify.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=${fabric_loader_version}",
    "fabric-api": "*",
    "minecraft": "${minecraft_version}",
    "java": ">=${java_version}",
    "controlify": "${controlify_fabric_version_range}"
  },
  "suggests": {
    "modmenu": "*"
  }
}
